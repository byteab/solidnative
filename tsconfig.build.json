{
  "//": "The published build: each package compiled by tsc to JavaScript and declarations in its dist. A package compiles against the declarations of the ones it depends on, which Nx builds first; each path below is the declaration file that package's publishConfig.exports names. A subpath list falls back in order, so `x/solid/y` and the root alias `x/y` both find `dist/solid/y.d.ts`.",
  "extends": "./tsconfig.published.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@solidnative/fabric": ["./packages/fabric/dist/index.d.ts"],
      "@solidnative/fabric/*": ["./packages/fabric/dist/*.d.ts"],
      "@solidnative/platform": ["./packages/platform/dist/solid.d.ts"],
      "@solidnative/platform/*": ["./packages/platform/dist/*.d.ts"],
      "@solidnative/device": ["./packages/device/dist/solid.d.ts"],
      "@solidnative/device/*": ["./packages/device/dist/*.d.ts"],
      "@solidnative/router": ["./packages/router/dist/solid.d.ts"],
      "@solidnative/router/*": ["./packages/router/dist/*.d.ts"],
      "@solidnative/icons": ["./packages/icons/dist/solid.d.ts"],
      "@solidnative/icons/*": ["./packages/icons/dist/*.d.ts"],
      "@solidnative/components": ["./packages/components/dist/solid.d.ts"],
      "@solidnative/components/*": [
        "./packages/components/dist/solid/*.d.ts",
        "./packages/components/dist/*.d.ts"
      ],
      "@solidnative/expo": ["./packages/expo/dist/solid.d.ts"],
      "@solidnative/expo/*": ["./packages/expo/dist/solid/*.d.ts", "./packages/expo/dist/*.d.ts"],
      "@solidnative/web": ["./packages/web/dist/solid/index.d.ts"],
      "@solidnative/web/solid": ["./packages/web/dist/solid/index.d.ts"],
      "@solidnative/web/vite": ["./packages/web/solid-vite.d.mts"],
      "@solidnative/web/solid/vite": ["./packages/web/solid-vite.d.mts"],
      "@solidnative/web/*": ["./packages/web/dist/solid/*.d.ts", "./packages/web/dist/*.d.ts"],
      "@solidnative/testing": ["./packages/testing/dist/index.d.ts"],
      "@solidnative/testing/vitest": ["./packages/testing/vitest.d.mts"],
      "@solidnative/testing/*": ["./packages/testing/dist/*.d.ts"]
    }
  }
}
