node_modules/
*.generated.ts
.expo/
dist/
.claude/worktrees/
.nx/*
# Version plans are written by hand and consumed by a release: see RELEASING.md.
!.nx/version-plans/
# Generated by `expo prebuild` from app.json, and rebuilt on demand.
examples/*/ios/
examples/*/android/
# Expo's CLI drops one of these at whatever directory it is run from; ours is tsconfig.base.json.
/tsconfig.json
# Scratch directories the Tailwind wiring test makes, inside the workspace because the CLI
# resolves its imports from the input file's directory.
packages/integration-tests/.tailwind-test-*
.verdaccio/
# Vitest browser mode writes a screenshot of the page beside every failing browser test here.
# Useful while fixing one, meaningless a commit later.
.vitest/
# Playwright's traces and reports from the documentation's end-to-end tests.
test-results/
playwright-report/

# Merged lcov and the summary `scripts/coverage.mjs` writes.
coverage/

# Tarballs the release workflow packs before publishing.
.release/

# The design hook's local cache. Its config.json holds shared ignores and is committed.
.impeccable/hook.cache.json
.impeccable/config.local.json

# Docs code-sample fixtures the docs-samples test writes, one per ```ts/```tsx block, as
# `*.generated.ts(x)`; ignored as a directory so they are easy to spot and bulk-clean.
packages/integration-tests/.docs-samples/

