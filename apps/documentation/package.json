{
  "name": "documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5201",
    "build": "vite build && node build/prerender.ts && pagefind --site dist",
    "preview": "vite preview --port 5201",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/learn/lessons/tsconfig.json --noEmit",
    "prerender": "node build/prerender.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@solid-native/components": "workspace:*",
    "@solid-native/device": "workspace:*",
    "@solid-native/fabric": "workspace:*",
    "@solid-native/icons": "workspace:*",
    "@solid-native/metro": "workspace:*",
    "@solid-native/platform": "workspace:*",
    "@solid-native/tailwind": "workspace:*",
    "@solid-native/testing": "workspace:*",
    "@solid-native/web": "workspace:*",
    "front-matter": "^4.0.2",
    "lightningcss-wasm": "1.33.0",
    "marked": "^18.0.14",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "shiki": "^1.29.2",
    "solid-js": "1.9.15",
    "sucrase": "3.35.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@solid-native/router": "workspace:*",
    "@solid-native/template": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "nx": {
    "tags": [
      "scope:documentation",
      "layer:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/template/AGENTS.md"
        ]
      }
    }
  },
  "license": "MIT"
}
