{
  "name": "@solidnative/template",
  "version": "0.1.2",
  "description": "A SolidJS app rendering real native views. Use with create-expo-app --template.",
  "license": "MIT",
  "main": "src/main.solid.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @solidnative/testing/register --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@solidnative/components": "workspace:*",
    "@solidnative/device": "workspace:*",
    "@solidnative/fabric": "workspace:*",
    "@solidnative/metro": "workspace:*",
    "@solidnative/platform": "workspace:*",
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@solidnative/testing": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteab/solidnative.git",
    "directory": "template"
  },
  "publishConfig": {
    "access": "public"
  }
}
