    }
  },
  {
    "name": "important beats a later, more specific rule",
    "expected": {
      "color": "rgb(1, 0, 0)",
      "background-color": "rgba(0, 0, 0, 0)"
    }
  },
  {
    "name": "an attribute selector weighs the same as a class",
