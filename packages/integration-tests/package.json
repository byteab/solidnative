{
  "name": "@solid-native/integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run test:solid",
    "test:solid": "node --import @solid-native/testing/register --test \"*.test.ts\"",
    "test:worker": "node --conditions=worker --conditions=development --import @solid-native/testing/register --test \"*.test.ts\"",
    "css-oracle": "node scripts/generate-css-oracle.mjs",
    "tailwind-oracle": "node scripts/generate-tailwind-oracle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:tailwind": "node --no-opt --no-sparkplug --no-maglev --import @solid-native/testing/register bench/tailwind.bench.ts"
  },
  "nx": {
    "tags": [
      "scope:integration-tests",
      "layer:tests"
    ]
  },
  "devDependencies": {
    "@babel/generator": "^7.29.8",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solid-native/components": "workspace:*",
    "@solid-native/device": "workspace:*",
    "@solid-native/expo": "workspace:*",
    "@solid-native/fabric": "workspace:*",
    "@solid-native/icons": "workspace:*",
    "@solid-native/metro": "workspace:*",
    "@solid-native/platform": "workspace:*",
    "@solid-native/router": "workspace:*",
    "@solid-native/tailwind": "workspace:*",
    "@solid-native/testing": "workspace:*",
    "@solid-native/web": "workspace:*",
    "@picocss/pico": "2.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.2.4",
    "bootstrap": "5.3.8",
    "bulma": "1.0.4",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "^7.0.1",
    "expo-background-task": "~57.0.20",
    "expo-battery": "~57.0.2",
    "expo-camera": "^57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.3",
    "expo-task-manager": "~57.0.20",
    "lucide-static": "^1.48.0",
    "metro-resolver": "^0.84.5",
    "open-props": "1.7.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "solid-js": "1.9.15",
    "tailwindcss": "^4.3.3",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yoga-layout": "3.2.1"
  }
}
